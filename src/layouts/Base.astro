---
/* Layout base: <head>, fuentes, SEO en español y esqueleto de la página.
   El header y el footer se inyectan por slot cuando se construyan (etapa 1). */
import { getImage } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/movimiento.css';
import imagenSocial from '../assets/img/bg-escenario.jpg';
import { contenido, enlaceInstagram } from '../data/contenido';

interface Props {
  /** Título de la página. Sin valor, se usa el título del inicio. */
  titulo?: string;
  descripcion?: string;
  /** Imagen para redes (1200 × 630). Sin valor, se usa la del escenario. */
  imagen?: ImageMetadata;
  /** Evita que los buscadores indexen la página (p. ej. vistas internas). */
  noindex?: boolean;
}

const { club, contacto } = contenido;
const { titulo, descripcion, imagen = imagenSocial, noindex = false } = Astro.props;

const nombreSitio = club.nombre;
const tituloBase = `${nombreSitio} · Cheerleading en Santiago · Temporada ${contenido._temporada}`;
const tituloCompleto = titulo ? `${titulo} · ${nombreSitio}` : tituloBase;
const descripcionFinal =
  descripcion ??
  `Club de cheerleading de ${club.ciudad.split(',')[0]} desde ${club.fundacion}. ${club.edades}. ${club.mensajeClave}: inscripciones abiertas para la temporada ${contenido._temporada}.`;

const sitio = Astro.site ?? new URL(Astro.url.origin);
const canonica = new URL(Astro.url.pathname, sitio).href;
const imagenSocialFinal = await getImage({ src: imagen, width: 1200, height: 630, format: 'jpg' });
const urlImagen = new URL(imagenSocialFinal.src, sitio).href;

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: nombreSitio,
  description: descripcionFinal,
  slogan: club.lema,
  url: sitio.href,
  image: urlImagen,
  foundingDate: String(club.fundacion),
  telephone: contacto.whatsappHeadCoach,
  sport: 'Cheerleading',
  address: {
    '@type': 'PostalAddress',
    addressLocality: club.ciudad.split(',')[0],
    addressCountry: 'CL',
  },
  sameAs: [enlaceInstagram()],
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcionFinal} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nombreSitio} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcionFinal} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcionFinal} />
    <meta name="twitter:image" content={urlImagen} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700;800&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot name="header" />
    <main id="contenido">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
