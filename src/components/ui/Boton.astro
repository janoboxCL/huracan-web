---
/* Botón de marca: paralelogramo (skewX), brillo que cruza y sombra dura al hover.
   Es un enlace real (`href`) o un botón real (`type`). */
interface Props {
  href?: string;
  /** amarillo: relleno de acción · contorno: borde blanco · negro: relleno negro (sobre amarillo)
      · borde: negro con borde amarillo (header). */
  variante?: 'amarillo' | 'contorno' | 'negro' | 'borde';
  tamano?: 'normal' | 'grande';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variante = 'amarillo', tamano = 'normal', type = 'button', class: clase } = Astro.props;
const Elemento = href ? 'a' : 'button';
const atributos = href ? { href } : { type };
---

<Elemento {...atributos} class:list={['boton', `boton--${variante}`, `boton--${tamano}`, clase]}>
  <slot />
</Elemento>

<style>
  .boton {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.8rem 1.4rem;
    border: 2px solid transparent;
    font-family: inherit;
    font-weight: 800;
    font-size: var(--t-base);
    line-height: 1.15;
    text-decoration: none;
    text-align: center;
    overflow: hidden;
    transform: skewX(-10deg);
    transition:
      transform var(--dur-rapida) var(--curva-suave),
      box-shadow var(--dur-rapida) var(--curva-suave);
  }

  .boton--grande {
    min-height: 3.75rem;
    padding: 1.1rem 2rem;
    font-size: var(--t-lg);
  }

  .boton--amarillo {
    background: var(--amarillo);
    color: var(--negro);
  }

  .boton--contorno {
    color: var(--blanco);
    border-color: var(--blanco);
  }

  .boton--negro {
    background: var(--negro);
    color: var(--amarillo);
  }

  .boton--borde {
    background: var(--negro);
    color: var(--amarillo);
    border-color: var(--amarillo);
  }

  /* Brillo que cruza (solo transform). */
  .boton::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    background: rgb(255 255 255 / 0.5);
    transform: translateX(-120%) skewX(-25deg);
    pointer-events: none;
  }

  .boton:hover,
  .boton:focus-visible {
    transform: translateY(-3px) skewX(-12deg);
    box-shadow: var(--sombra-dura-blanca);
  }

  .boton--negro:hover,
  .boton--negro:focus-visible,
  .boton--borde:hover,
  .boton--borde:focus-visible {
    box-shadow: var(--sombra-dura-amarilla);
  }

  @media (prefers-reduced-motion: no-preference) {
    .boton:hover::after {
      animation: brillo 0.6s ease-out;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boton:hover,
    .boton:focus-visible {
      transform: skewX(-10deg);
    }
  }

  @keyframes brillo {
    from {
      transform: translateX(-120%) skewX(-25deg);
    }
    to {
      transform: translateX(260%) skewX(-25deg);
    }
  }
</style>
