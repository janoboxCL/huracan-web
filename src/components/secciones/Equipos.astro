---
/* 5 · 03 Equipos (amarillo, corte diagonal superior): buscador por edad.
   Única isla con JS de la etapa 1, con mejora progresiva: el servidor pinta los
   equipos con sus rangos en `data-edad-min` / `data-edad-max`; el script solo
   muestra u oculta tarjetas. Sin JS se ve el listado completo; los botones de
   edad y el resumen (que dependen del script) permanecen ocultos. */
import { Image } from 'astro:assets';
import flyer from '../../assets/img/cut-flyer.png';
import { contenido, equiposPorEdad, programaPorId } from '../../data/contenido';
import { enlaces } from '../../data/enlaces';
import Boton from '../ui/Boton.astro';
import Etiqueta from '../ui/Etiqueta.astro';

const { equipos, programas, _temporada } = contenido;

/* Botones: de 4 años (edad mínima del club) a 20. El último, «20+», agrupa
   20 años o más y se resuelve con la regla `edadMax === null` del JSON. */
const EDAD_MIN = 4;
const EDAD_TOPE = 20;
/* Edad inicial de la maqueta (10): muestra de entrada un resultado útil. */
const EDAD_INICIAL = 10;

const edades = Array.from({ length: EDAD_TOPE - EDAD_MIN + 1 }, (_, i) => {
  const n = EDAD_MIN + i;
  return { n, etiqueta: n === EDAD_TOPE ? `${n}+` : String(n) };
});

const generos = { mixto: 'Mixto', damas: 'Damas' } as const;

const iniciales = equiposPorEdad(EDAD_INICIAL);
const textoInicial = `${iniciales.length} equipos para ${EDAD_INICIAL} años`;

/* Equipos con inicio diferido (Spirit, Team Parent): la etiqueta es la primera frase de la nota
   del JSON («Comienza en abril de 2027»); el resto de la nota va como detalle breve. */
function avisoInicio(e: (typeof equipos)[number]): { etiqueta: string; detalle: string } | null {
  if (!e.inicio && !e.nota) return null;
  if (!e.nota) return { etiqueta: `Inicio: ${e.inicio}`, detalle: '' };
  const corte = e.nota.indexOf('. ');
  const primera = corte === -1 ? e.nota : e.nota.slice(0, corte + 1);
  return { etiqueta: primera.replace(/\.$/, ''), detalle: corte === -1 ? '' : e.nota.slice(corte + 2) };
}

const tarjetas = equipos.map((e) => ({
  ...e,
  aviso: avisoInicio(e),
  programaNombre: programaPorId(e.programa).nombre,
  genero: generos[e.genero],
  visible: iniciales.includes(e),
}));
---

<section class="equipos sobre-amarillo" id="equipos" aria-labelledby="equipos-titulo" data-edad-tope={EDAD_TOPE}>
  <Image
    class="equipos__flyer soplo-der"
    src={flyer}
    alt=""
    aria-hidden="true"
    widths={[320, 640]}
    sizes="20rem"
    loading="lazy"
    decoding="async"
  />

  <div class="equipos__cuerpo contenedor">
    <div class="equipos__cabecera soplo">
      <Etiqueta variante="seccion">03 · Equipos {_temporada}</Etiqueta>
      <h2 id="equipos-titulo" class="disp equipos__titulo">¿Qué equipo<br />es para ti?</h2>
      <p class="equipos__bajada" data-bajada-base>
        Los {equipos.length} equipos de la temporada {_temporada}. El equipo final lo define la evaluación.
      </p>
      <p class="equipos__bajada" data-bajada-js hidden>
        Toca la edad que cumple en {_temporada}. El equipo final lo define la evaluación.
      </p>
    </div>

    <div class="equipos__edades" role="group" aria-label={`Edad cumplida en ${_temporada}`} hidden data-edades>
      {
        edades.map((e) => (
          <button
            type="button"
            class="disp edad"
            data-edad={e.n}
            aria-pressed={e.n === EDAD_INICIAL ? 'true' : 'false'}
            aria-label={e.n === EDAD_TOPE ? `${e.etiqueta} años` : `${e.n} años`}
          >
            {e.etiqueta}
          </button>
        ))
      }
    </div>

    <p class="equipos__resumen" aria-live="polite" hidden data-resumen>{textoInicial}</p>

    <div class="equipos__accion">
      <Boton href={enlaces.agenda} variante="negro" tamano="grande" etiqueta="Realiza tu inscripción, desde equipos"><span data-cta-texto>Realiza tu inscripción →</span></Boton>
    </div>

    <ul role="list" class="equipos__leyenda" aria-label="Color por programa">
      {programas.map((p) => <li><span class={`equipos__muestra equipos__muestra--${p.id}`} aria-hidden="true"></span>{p.nombre}</li>)}
    </ul>

    <ul role="list" class="equipos__lista" data-lista>
      {
        tarjetas.map((t) => (
          <li class="equipo" data-edad-min={t.edadMin} data-edad-max={t.edadMax ?? ''}>
            <article class={`equipo__tarjeta equipo__tarjeta--${t.programa}`}>
              <p class="equipo__tipo">
                {t.categoria.toLowerCase().startsWith(t.programaNombre.toLowerCase()) ? t.categoria : `${t.programaNombre} · ${t.categoria}`}
              </p>
              <h3 class="disp equipo__nombre">{t.nombre}</h3>
              <p class="equipo__rango">{t.rango}</p>
              {t.aviso && <p class="equipo__inicio">{t.aviso.etiqueta}</p>}
              {t.aviso?.detalle && <p class="equipo__nota">{t.aviso.detalle}</p>}
              <p class="equipo__genero">{t.genero}</p>
            </article>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .equipos {
    position: relative;
    margin-top: calc(var(--corte-diagonal) * -1);
    background: var(--amarillo);
    color: var(--negro);
    clip-path: polygon(0 0, 100% var(--corte-diagonal), 100% 100%, 0 100%);
    overflow: clip;
  }

  .equipos :global(.equipos__flyer) {
    display: none;
    position: absolute;
    right: 2%;
    bottom: 0;
    width: auto;
    height: clamp(30rem, 52vw, 47.5rem);
    filter: drop-shadow(-18px 0 0 var(--negro));
  }

  .equipos__cuerpo {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--esp-6);
    padding-block: calc(var(--corte-diagonal) + var(--seccion-y)) var(--seccion-y);
  }

  .equipos__cabecera {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
    max-width: 48.75rem;
  }

  .equipos__titulo {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 1.05; /* el «¿» invertido baja y no debe tocar la segunda línea */
  }

  .equipos__bajada {
    font-size: var(--t-md);
    line-height: 1.6;
  }

  /* Botones de edad: parte del buscador, solo existen con JS. */
  .equipos__edades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    padding-inline: 0.5rem; /* holgura para la inclinación */
    max-width: 53.75rem;
  }

  .equipos__edades[hidden],
  .equipos__resumen[hidden],
  .equipos__bajada[hidden],
  .equipo[hidden] {
    display: none;
  }

  .edad {
    min-width: 3.5rem;
    min-height: 3.25rem;
    padding: 0 0.875rem;
    border: 3px solid var(--negro);
    background: var(--blanco);
    color: var(--negro);
    font-size: 1.625rem;
    transform: skewX(-10deg);
    transition:
      transform var(--dur-rapida) var(--curva-suave),
      box-shadow var(--dur-rapida) var(--curva-suave);
  }

  @media (hover: hover) {
    .edad:hover {
      transform: translateY(-3px) skewX(-10deg);
      box-shadow: 5px 5px 0 var(--negro);
    }
  }

  .edad:active {
    transform: skewX(-10deg);
    box-shadow: none;
  }

  .edad[aria-pressed='true'] {
    background: var(--negro);
    color: var(--amarillo);
  }

  /* El botón activo ya es negro: el anillo de foco negro se separa con un halo amarillo. */
  .edad[aria-pressed='true']:focus-visible {
    box-shadow: 0 0 0 3px var(--amarillo);
  }

  .equipos__resumen {
    font-size: var(--t-md);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .equipos__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.25rem), 1fr));
    gap: 0.875rem;
    align-content: start; /* la altura reservada no estira las filas */
    max-width: 56rem;
    padding: 0 0.5rem; /* holgura para la inclinación */
  }

  .equipo {
    display: flex;
    min-width: 0;
  }

  /* Móvil: una sola fila deslizable, para que la altura no dependa de cuántos
     equipos coinciden. */
  @media (max-width: 39.99rem) {
    .equipos__lista {
      display: flex;
      gap: 0.875rem;
      margin-inline: calc(var(--margen) * -1);
      padding: 0 var(--margen) 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    .equipo {
      flex: 0 0 min(82%, 19rem);
      scroll-snap-align: start;
    }
  }

  .equipo__tarjeta {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--esp-2);
    min-width: 0;
    padding: 1.375rem;
    border: 3px solid var(--negro); /* separa la tarjeta amarilla (Prep) del fondo amarillo */
    background: var(--negro);
    color: var(--blanco);
    transform: skewX(-4deg);
  }

  /* Color por programa (igual que 02 · Programas). Texto negro sobre gris #a3a3a3 (7,8:1), blanco y amarillo. */
  .equipo__tarjeta--recreativo {
    background: var(--gris-recreativo);
    color: var(--negro);
  }

  .equipo__tarjeta--novice {
    background: var(--blanco);
    color: var(--negro);
  }

  .equipo__tarjeta--prep {
    background: var(--amarillo);
    color: var(--negro);
  }

  .equipo__tarjeta--recreativo .equipo__tipo,
  .equipo__tarjeta--novice .equipo__tipo,
  .equipo__tarjeta--prep .equipo__tipo,
  .equipo__tarjeta--recreativo .equipo__rango,
  .equipo__tarjeta--novice .equipo__rango,
  .equipo__tarjeta--prep .equipo__rango,
  .equipo__tarjeta--recreativo .equipo__nota,
  .equipo__tarjeta--novice .equipo__nota,
  .equipo__tarjeta--prep .equipo__nota {
    color: var(--negro);
  }

  /* Etiqueta de inicio: sobre negro, amarilla; sobre los demás, negra con texto blanco. */
  .equipo__tarjeta--recreativo .equipo__inicio,
  .equipo__tarjeta--novice .equipo__inicio,
  .equipo__tarjeta--prep .equipo__inicio {
    background: var(--negro);
    color: var(--blanco);
  }

  .equipo__tarjeta--recreativo .equipo__genero,
  .equipo__tarjeta--novice .equipo__genero,
  .equipo__tarjeta--prep .equipo__genero {
    border-color: var(--negro);
    color: var(--negro);
  }

  .equipos__leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2) var(--esp-5);
    margin: 0;
    padding: 0 0.5rem;
    list-style: none;
    font-size: var(--t-sm);
    font-weight: 700;
  }

  .equipos__muestra {
    display: inline-block;
    width: 1.125rem;
    height: 0.875rem;
    margin-right: 0.5rem;
    vertical-align: -1px;
    border: 2px solid var(--negro);
  }

  .equipos__muestra--recreativo { background: var(--gris-recreativo); }
  .equipos__muestra--novice { background: var(--blanco); }
  .equipos__muestra--prep { background: var(--amarillo); }
  .equipos__muestra--international { background: var(--negro); }

  .equipo__tipo {
    color: var(--amarillo);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .equipo__nombre {
    font-size: 2.375rem;
    overflow-wrap: anywhere;
  }

  .equipo__rango {
    font-size: 0.9375rem;
    color: var(--texto-2);
  }

  /* Inicio diferido: etiqueta amarilla sobre la tarjeta negra (AA) y nota breve. */
  .equipo__inicio {
    align-self: flex-start;
    padding: 0.2rem 0.625rem;
    background: var(--amarillo);
    color: var(--negro);
    font-size: var(--t-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .equipo__nota {
    color: var(--texto-2);
    font-size: var(--t-sm);
    line-height: 1.45;
  }

  .equipo__genero {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.125rem 0.625rem;
    border: 2px solid var(--amarillo);
    color: var(--amarillo);
    font-size: var(--t-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .equipos__accion {
    display: flex;
    padding-inline: 0.5rem;
  }

  /* Tras la primera interacción, las tarjetas que aparecen entran con un soplo. */
  @media (prefers-reduced-motion: no-preference) {
    .equipos[data-activo] .equipo:not([hidden]) .equipo__tarjeta {
      animation: aparece var(--dur-media) var(--curva-soplo) both;
    }
  }

  @keyframes aparece {
    from {
      opacity: 0;
      transform: translateX(-28px) skewX(-12deg);
    }
    to {
      opacity: 1;
      transform: skewX(-4deg);
    }
  }

  @media (min-width: 72rem) {
    .equipos :global(.equipos__flyer) {
      display: block;
    }

    /* Deja libre el lado derecho para el recorte. */
    .equipos__cabecera,
    .equipos__edades,
    .equipos__lista {
      max-width: min(56rem, calc(100% - 21rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edad:hover {
      transform: skewX(-10deg);
    }
  }
</style>

<script>
  /* Buscador por edad: muestra u oculta las tarjetas ya renderizadas.
     Regla de rango (igual a `equiposPorEdad`): edadMin <= edad y, si hay
     edadMax, edad <= edadMax. «20+» = 20 años o más. */
  const seccion = document.querySelector<HTMLElement>('#equipos');
  const grupo = seccion?.querySelector<HTMLElement>('[data-edades]');
  const resumen = seccion?.querySelector<HTMLElement>('[data-resumen]');
  const botones = Array.from(seccion?.querySelectorAll<HTMLButtonElement>('[data-edad]') ?? []);
  const tarjetas = Array.from(seccion?.querySelectorAll<HTMLElement>('[data-lista] > li') ?? []);

  if (seccion && grupo && resumen && botones.length && tarjetas.length) {
    const tope = Number(seccion.dataset.edadTope);
    let actual: number | null = null;
    const coincideCon = (li: HTMLElement, edad: number) => {
      const min = Number(li.dataset.edadMin);
      const max = li.dataset.edadMax === '' ? null : Number(li.dataset.edadMax);
      return edad >= min && (max === null || edad <= max);
    };

    const lista = seccion.querySelector<HTMLElement>('[data-lista]')!;
    const cta = seccion.querySelector<HTMLElement>('[data-cta-texto]');
    const edades = botones.map((b) => Number(b.dataset.edad));

    /* Reserva de altura para que el CTA y lo siguiente no salten (medida en el
       navegador). En móvil la fila es deslizable y estable: se reserva el peor caso.
       En tablet y escritorio se limita a 2 filas de tarjetas, para no dejar un vacío
       enorme con pocas tarjetas; un salto moderado al cambiar de edad es aceptable. */
    const movil = matchMedia('(max-width: 39.99rem)');
    const reservar = () => {
      lista.style.minHeight = '0px';
      let peor = 0;
      let tarjetaMax = 0;
      for (const e of edades) {
        for (const li of tarjetas) {
          li.hidden = !coincideCon(li, e);
          if (!li.hidden) tarjetaMax = Math.max(tarjetaMax, li.offsetHeight);
        }
        peor = Math.max(peor, lista.offsetHeight);
      }
      const dosFilas = tarjetaMax * 2 + 14;
      const alto = movil.matches ? peor : Math.min(peor, dosFilas);
      lista.style.minHeight = `${alto}px`;
      if (actual !== null) for (const li of tarjetas) li.hidden = !coincideCon(li, actual);
    };

    const aplicar = (edad: number, interactivo: boolean) => {
      if (interactivo) seccion.dataset.activo = '';
      let total = 0;
      actual = edad;
      lista.scrollLeft = 0;
      for (const li of tarjetas) {
        const coincide = coincideCon(li, edad);
        li.hidden = !coincide;
        if (coincide) total += 1;
      }
      for (const b of botones) b.setAttribute('aria-pressed', String(Number(b.dataset.edad) === edad));
      const sujeto = total === 1 ? '1 equipo' : `${total} equipos`;
      const anios = edad >= tope ? `${tope} años o más` : `${edad} años`;
      resumen.textContent = total === 0 ? `Sin equipos para ${anios}` : `${sujeto} para ${anios}`;
      enfocable();
    };

    /* La lista solo entra en el orden del teclado cuando realmente desborda (fila
       deslizable en móvil); así no hay una parada de Tab sin nada que desplazar. */
    function enfocable() {
      const desborda =
        getComputedStyle(lista).overflowX !== 'visible' && lista.scrollWidth > lista.clientWidth + 16;
      if (desborda) lista.tabIndex = 0;
      else lista.removeAttribute('tabindex');
    }

    for (const b of botones) b.addEventListener('click', () => aplicar(Number(b.dataset.edad), true));
    const inicial = botones.find((b) => b.getAttribute('aria-pressed') === 'true') ?? botones[0]!;
    aplicar(Number(inicial.dataset.edad ?? 0), false);
    grupo.hidden = false;
    resumen.hidden = false;
    seccion.querySelector<HTMLElement>('[data-bajada-base]')!.hidden = true;
    seccion.querySelector<HTMLElement>('[data-bajada-js]')!.hidden = false;
    if (cta) {
      cta.textContent = 'Realiza tu inscripción para esta edad →';
      cta.closest('a')?.setAttribute('aria-label', 'Realiza tu inscripción para esta edad, desde equipos');
    }
    lista.setAttribute('aria-label', 'Equipos para la edad elegida');
    reservar();
    enfocable();
    new ResizeObserver(enfocable).observe(lista);
    let t: number | undefined;
    addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(reservar, 150);
    });
    document.fonts?.ready.then(reservar);
  }
</script>
