---
/* Header transparente. Se inyecta por el slot `header` de Base y se superpone al
   hero (position: absolute). La navegación va sobre una pastilla oscura para
   mantener contraste AA tanto sobre la foto como sobre el bloque amarillo. */
import { Image } from 'astro:assets';
import logo from '../../assets/img/logo.png';
import { contenido } from '../../data/contenido';
import { enlaces, navegacion } from '../../data/enlaces';
import Boton from '../ui/Boton.astro';

const { nombre } = contenido.club;
const [primera, ...resto] = nombre.split(' ');
---

<header class="header">
  <div class="header__interior contenedor">
    <a class="marca" href={enlaces.inicio} aria-label={`${nombre}, inicio`}>
      <Image src={logo} alt="" width={50} densities={[1, 2]} loading="eager" class="marca__logo" />
      <span class="disp marca__nombre">{primera}<br /><span class="marca__sub">{resto.join(' ')}</span></span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list" class="nav__lista">
        {
          navegacion.map((item) => (
            <li>
              <a href={item.href}>{item.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Boton href={enlaces.agenda} variante="borde" class="header__cta">Agenda tu evaluación</Boton>
  </div>
</header>

<style>
  .header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
  }

  .header__interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-3) var(--esp-5);
    padding-block: var(--esp-4);
  }

  .marca {
    display: flex;
    align-items: center;
    gap: var(--esp-3);
    color: var(--blanco);
    text-decoration: none;
  }

  .marca__logo {
    width: 50px;
    height: auto;
  }

  .marca__nombre {
    font-size: 1.625rem;
    line-height: 0.95;
  }

  .marca__sub {
    font-size: 1.125rem;
    color: var(--amarillo);
  }

  .header :global(.header__cta) {
    margin-left: auto;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    font-size: var(--t-sm);
  }

  .nav {
    order: 3;
    flex-basis: 100%;
    background: rgb(10 10 10 / 0.82);
    padding: var(--esp-2) var(--esp-4);
  }

  .nav__lista {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--esp-1) var(--esp-5);
    margin: 0;
    padding: 0;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--blanco);
    font-weight: 700;
    font-size: var(--t-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--amarillo);
  }

  @media (min-width: 70rem) {
    .header__interior {
      flex-wrap: nowrap;
    }

    .nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
      padding-inline: var(--esp-5);
      transform: skewX(-10deg);
    }

    .nav a {
      transform: skewX(10deg);
      font-size: var(--t-base);
    }

    .header :global(.header__cta) {
      margin-left: 0;
      min-height: 3rem;
      padding: 0.8rem 1.4rem;
      font-size: var(--t-base);
    }
  }
</style>
